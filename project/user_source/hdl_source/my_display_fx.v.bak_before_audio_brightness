`timescale 1ns/1ps
//=============================================================================
// Original real-time image-processing pipeline for the HX4S20 multimedia demo.
// Modes: 0 passthrough; 1 adaptive enhancement; 2 contour fusion;
//        3 warm posterization.  key3 selects the mode at a frame boundary.
// OSD: "FPGA PLAYER" plus the current mode name on a dark background.
//=============================================================================
module my_display_fx #(
    parameter H_ACTIVE       = 640,
    parameter V_ACTIVE       = 480,
    parameter FADE_PER_FRAME = 8'd16
)(
    input  wire        video_clk,
    input  wire        rst,
    input  wire        hs,
    input  wire        vs,
    input  wire        de,
    input  wire [1:0]  disp_buf_idx,
    input  wire        effect_next,
    input  wire        image_change_start,
    input  wire [23:0] rgb_in,
    output reg         hs_o,
    output reg         vs_o,
    output reg         de_o,
    output reg  [23:0] rgb_o,
    output reg  [1:0]  effect_mode,
    output reg  [7:0]  scene_luma
);

    function [7:0] abs_diff8;
        input [7:0] a;
        input [7:0] b;
        begin
            abs_diff8 = (a >= b) ? (a - b) : (b - a);
        end
    endfunction

    function [7:0] clamp_s11;
        input signed [10:0] value;
        begin
            if (value < 0)
                clamp_s11 = 8'd0;
            else if (value > 11'sd255)
                clamp_s11 = 8'd255;
            else
                clamp_s11 = value[7:0];
        end
    endfunction

    function [7:0] poster_level;
        input [7:0] value;
        begin
            case (value[7:5])
                3'd0: poster_level = 8'd8;
                3'd1: poster_level = 8'd40;
                3'd2: poster_level = 8'd72;
                3'd3: poster_level = 8'd104;
                3'd4: poster_level = 8'd144;
                3'd5: poster_level = 8'd184;
                3'd6: poster_level = 8'd224;
                default: poster_level = 8'd255;
            endcase
        end
    endfunction

    function [63:0] glyph64;
        input [7:0] c;
        begin
            case (c)
                "A": glyph64 = 64'h1824427E42424200;
                "C": glyph64 = 64'h3C42404040423C00;
                "D": glyph64 = 64'h7844424242447800;
                "E": glyph64 = 64'h7E40407C40407E00;
                "F": glyph64 = 64'h7E40407C40404000;
                "G": glyph64 = 64'h3C42404E42423C00;
                "H": glyph64 = 64'h4242427E42424200;
                "I": glyph64 = 64'h3E08080808083E00;
                "L": glyph64 = 64'h4040404040407E00;
                "M": glyph64 = 64'h42665A5A42424200;
                "N": glyph64 = 64'h4262524A46424200;
                "O": glyph64 = 64'h3C42424242423C00;
                "P": glyph64 = 64'h7C42427C40404000;
                "R": glyph64 = 64'h7C42427C48444200;
                "S": glyph64 = 64'h3C42403C02423C00;
                "T": glyph64 = 64'h7F08080808080800;
                "U": glyph64 = 64'h4242424242423C00;
                "Y": glyph64 = 64'h4242241818181800;
                ":": glyph64 = 64'h0018180018180000;
                "-": glyph64 = 64'h0000007E00000000;
                "0": glyph64 = 64'h3C464A5262423C00;
                "2": glyph64 = 64'h3C42020C30607E00;
                "6": glyph64 = 64'h1C20407C42423C00;
                default: glyph64 = 64'h0000000000000000;
            endcase
        end
    endfunction


    // 63-character scrolling contest subtitle, rendered with the OSD font.
    function [7:0] ticker_char;
        input [5:0] index;
        begin
            case (index)
                6'd0: ticker_char = "F";
                6'd1: ticker_char = "P";
                6'd2: ticker_char = "G";
                6'd3: ticker_char = "A";
                6'd4: ticker_char = " ";
                6'd5: ticker_char = "H";
                6'd6: ticker_char = "D";
                6'd7: ticker_char = "M";
                6'd8: ticker_char = "I";
                6'd9: ticker_char = " ";
                6'd10: ticker_char = "M";
                6'd11: ticker_char = "U";
                6'd12: ticker_char = "L";
                6'd13: ticker_char = "T";
                6'd14: ticker_char = "I";
                6'd15: ticker_char = "M";
                6'd16: ticker_char = "E";
                6'd17: ticker_char = "D";
                6'd18: ticker_char = "I";
                6'd19: ticker_char = "A";
                6'd20: ticker_char = " ";
                6'd21: ticker_char = "P";
                6'd22: ticker_char = "L";
                6'd23: ticker_char = "A";
                6'd24: ticker_char = "Y";
                6'd25: ticker_char = "E";
                6'd26: ticker_char = "R";
                6'd27: ticker_char = " ";
                6'd28: ticker_char = "-";
                6'd29: ticker_char = " ";
                6'd30: ticker_char = "R";
                6'd31: ticker_char = "E";
                6'd32: ticker_char = "A";
                6'd33: ticker_char = "L";
                6'd34: ticker_char = " ";
                6'd35: ticker_char = "T";
                6'd36: ticker_char = "I";
                6'd37: ticker_char = "M";
                6'd38: ticker_char = "E";
                6'd39: ticker_char = " ";
                6'd40: ticker_char = "I";
                6'd41: ticker_char = "M";
                6'd42: ticker_char = "A";
                6'd43: ticker_char = "G";
                6'd44: ticker_char = "E";
                6'd45: ticker_char = " ";
                6'd46: ticker_char = "E";
                6'd47: ticker_char = "F";
                6'd48: ticker_char = "F";
                6'd49: ticker_char = "E";
                6'd50: ticker_char = "C";
                6'd51: ticker_char = "T";
                6'd52: ticker_char = "S";
                6'd53: ticker_char = " ";
                6'd54: ticker_char = "-";
                6'd55: ticker_char = " ";
                6'd56: ticker_char = "2";
                6'd57: ticker_char = "0";
                6'd58: ticker_char = "2";
                6'd59: ticker_char = "6";
                6'd60: ticker_char = " ";
                6'd61: ticker_char = " ";
                6'd62: ticker_char = " ";
                default: ticker_char = " ";
            endcase
        end
    endfunction

    // Zero-based coordinates while DE is asserted.
    reg [10:0] x;
    reg [10:0] y;
    reg        de_d;
    reg        vs_d;
    wire       de_rise = de & ~de_d;
    wire       frame_edge = vs & ~vs_d;

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            de_d <= 1'b0;
            vs_d <= 1'b0;
            x    <= 11'd0;
            y    <= 11'd0;
        end else begin
            de_d <= de;
            vs_d <= vs;
            if (frame_edge)
                y <= 11'd0;
            else if (de_rise)
                y <= y + 11'd1;
            if (de)
                x <= x + 11'd1;
            else
                x <= 11'd0;
        end
    end

    // Full transition: fade old frame out, wait for the double-buffer commit,
    // then fade the new frame in. All level changes occur at frame boundaries.
    localparam [2:0] TRANS_IDLE=3'd0, TRANS_FADE_OUT=3'd1,
                     TRANS_WAIT_NEW=3'd2, TRANS_FADE_IN=3'd3;
    reg [1:0] buf_s1, buf_s2, buf_s2_d;
    reg image_change_pending, transition_req_pending, effect_change_pending;
    reg [2:0] transition_state;
    reg fading;
    reg [7:0] fade;
    wire buffer_changed = (buf_s2 != buf_s2_d);

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            buf_s1<=0; buf_s2<=0; buf_s2_d<=0;
            image_change_pending<=0; transition_req_pending<=0;
            effect_change_pending<=0; effect_mode<=0;
            transition_state<=TRANS_IDLE; fading<=0; fade<=8'd255;
        end else begin
            buf_s1<=disp_buf_idx; buf_s2<=buf_s1; buf_s2_d<=buf_s2;
            if (buffer_changed) image_change_pending<=1'b1;
            if (image_change_start) transition_req_pending<=1'b1;
            if (effect_next) effect_change_pending<=1'b1;
            if (frame_edge) begin
                case (transition_state)
                    TRANS_IDLE: begin
                        fading<=0; fade<=8'd255;
                        if (transition_req_pending || image_change_start) begin
                            transition_req_pending<=0;
                            transition_state<=TRANS_FADE_OUT;
                            fading<=1; fade<=8'd255-FADE_PER_FRAME;
                        end else if (image_change_pending || buffer_changed) begin
                            image_change_pending<=0;
                            transition_state<=TRANS_FADE_IN;
                            fading<=1; fade<=0;
                        end else if (effect_change_pending || effect_next) begin
                            effect_mode<=effect_mode+2'd1;
                            effect_change_pending<=0;
                            transition_state<=TRANS_FADE_IN;
                            fading<=1; fade<=0;
                        end
                    end
                    TRANS_FADE_OUT: begin
                        fading<=1;
                        if (fade<=FADE_PER_FRAME) begin
                            fade<=0;
                            if (image_change_pending || buffer_changed) begin
                                image_change_pending<=0;
                                transition_state<=TRANS_FADE_IN;
                            end else transition_state<=TRANS_WAIT_NEW;
                        end else fade<=fade-FADE_PER_FRAME;
                    end
                    TRANS_WAIT_NEW: begin
                        fading<=1; fade<=0;
                        if (image_change_pending || buffer_changed) begin
                            image_change_pending<=0;
                            transition_state<=TRANS_FADE_IN;
                        end
                    end
                    default: begin
                        fading<=1;
                        if (fade>=(8'd255-FADE_PER_FRAME)) begin
                            fade<=8'd255; fading<=0; transition_state<=TRANS_IDLE;
                        end else fade<=fade+FADE_PER_FRAME;
                    end
                endcase
            end
        end
    end

    // Sparse frame measurement: 40 x 30 samples.  The shift gives a stable,
    // intentionally highlight-biased estimate without a divider.
    reg [19:0] sample_sum;
    wire [7:0] r_now = rgb_in[23:16];
    wire [7:0] g_now = rgb_in[15:8];
    wire [7:0] b_now = rgb_in[7:0];
    wire [9:0] luma_sum_now = {2'd0, r_now} +
                               ({2'd0, g_now} << 1) + {2'd0, b_now};
    wire [7:0] luma_now = luma_sum_now[9:2];
    wire       sample_pixel = de && (x[3:0] == 4'd0) &&
                               (y[3:0] == 4'd0);

    // Two-line, 2x-scaled OSD. The title is fixed; the second line follows
    // effect_mode and therefore changes at the same frame boundary as pixels.
    wire osd_line0 = de && (x >= 11'd24) && (x < 11'd200) &&
                           (y >= 11'd24) && (y < 11'd40);
    wire osd_line1 = de && (x >= 11'd24) && (x < 11'd280) &&
                           (y >= 11'd44) && (y < 11'd60);
    wire osd_box   = de && (x >= 11'd16) && (x < 11'd288) &&
                           (y >= 11'd16) && (y < 11'd68);
    reg [9:0] subtitle_scroll;
    reg subtitle_frame_div;
    wire subtitle_line = de && (y>=11'd452) && (y<11'd468);
    wire subtitle_box  = de && (y>=11'd444) && (y<11'd476);
    wire [10:0] subtitle_sum = {1'b0,subtitle_scroll}+x;
    wire [10:0] subtitle_pos = (subtitle_sum>=11'd1008) ?
                               subtitle_sum-11'd1008 : subtitle_sum;
    wire [5:0] subtitle_col = subtitle_pos[9:4];
    wire [2:0] subtitle_font_x = subtitle_pos[3:1];
    wire [2:0] subtitle_font_y = (y-11'd452)>>1;
    wire [4:0] osd_col = (x-11'd24)>>4;
    wire [2:0] osd_font_x = (x-11'd24)>>1;
    wire [2:0] text_font_x = subtitle_line ? subtitle_font_x : osd_font_x;
    wire [2:0] text_font_y = subtitle_line ? subtitle_font_y :
                             (osd_line0 ? ((y-11'd24)>>1) : ((y-11'd44)>>1));

    reg [7:0] osd_char;
    always @(*) begin
        osd_char = " ";
        if (osd_line0) begin
            case (osd_col)
                5'd0: osd_char = "F"; 5'd1: osd_char = "P";
                5'd2: osd_char = "G"; 5'd3: osd_char = "A";
                5'd5: osd_char = "P"; 5'd6: osd_char = "L";
                5'd7: osd_char = "A"; 5'd8: osd_char = "Y";
                5'd9: osd_char = "E"; 5'd10: osd_char = "R";
                default: osd_char = " ";
            endcase
        end else if (osd_line1) begin
            case (osd_col)
                5'd0: osd_char = "M"; 5'd1: osd_char = "O";
                5'd2: osd_char = "D"; 5'd3: osd_char = "E";
                5'd4: osd_char = ":";
                default: begin
                    case (effect_mode)
                        2'd0: begin
                            case (osd_col)
                                5'd6: osd_char = "O"; 5'd7: osd_char = "R";
                                5'd8: osd_char = "I"; 5'd9: osd_char = "G";
                                5'd10: osd_char = "I"; 5'd11: osd_char = "N";
                                5'd12: osd_char = "A"; 5'd13: osd_char = "L";
                                default: osd_char = " ";
                            endcase
                        end
                        2'd1: begin
                            case (osd_col)
                                5'd6: osd_char = "E"; 5'd7: osd_char = "N";
                                5'd8: osd_char = "H"; 5'd9: osd_char = "A";
                                5'd10: osd_char = "N"; 5'd11: osd_char = "C";
                                5'd12: osd_char = "E"; 5'd13: osd_char = "D";
                                default: osd_char = " ";
                            endcase
                        end
                        2'd2: begin
                            case (osd_col)
                                5'd6: osd_char = "C"; 5'd7: osd_char = "O";
                                5'd8: osd_char = "N"; 5'd9: osd_char = "T";
                                5'd10: osd_char = "O"; 5'd11: osd_char = "U";
                                5'd12: osd_char = "R";
                                default: osd_char = " ";
                            endcase
                        end
                        default: begin
                            case (osd_col)
                                5'd6: osd_char = "P"; 5'd7: osd_char = "O";
                                5'd8: osd_char = "S"; 5'd9: osd_char = "T";
                                5'd10: osd_char = "E"; 5'd11: osd_char = "R";
                                default: osd_char = " ";
                            endcase
                        end
                    endcase
                end
            endcase
        end else if (subtitle_line) begin
            osd_char = ticker_char(subtitle_col);
        end
    end

    wire [63:0] osd_glyph = glyph64(osd_char);
    wire [5:0] osd_row_shift = {(3'd7-text_font_y),3'b000};
    wire [7:0] osd_glyph_row = osd_glyph >> osd_row_shift;
    wire glyph_pixel = osd_glyph_row[3'd7-text_font_x];
    wire osd_text = (osd_line0 || osd_line1) && glyph_pixel;
    wire subtitle_text = subtitle_line && glyph_pixel;

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            sample_sum<=20'd0; scene_luma<=8'd128;
            subtitle_scroll<=10'd0; subtitle_frame_div<=1'b0;
        end else if (frame_edge) begin
            subtitle_frame_div<=~subtitle_frame_div;
            if (subtitle_frame_div)
                subtitle_scroll <= (subtitle_scroll==10'd1007) ?
                                   10'd0 : subtitle_scroll+10'd1;
            if (sample_sum > 20'd261120)
                scene_luma <= 8'd255;
            else
                scene_luma <= sample_sum[17:10];
            sample_sum <= 20'd0;
        end else if (sample_pixel) begin
            sample_sum <= sample_sum + {12'd0, luma_now};
        end
    end

    // One previous-line buffer produces a two-axis edge measure.
    reg [7:0] line_luma [0:H_ACTIVE-1];
    reg [7:0] left_luma;
    reg [8:0] edge_sum_p1;
    reg [7:0] luma_p1;
    reg [23:0] rgb_p1;
    reg        hs_p1;
    reg        vs_p1;
    reg        de_p1;
    reg        mode_bar_p1;
    reg        meter_bg_p1;
    reg        meter_fill_p1;
    reg        osd_box_p1;
    reg        osd_text_p1;
    reg        osd_marker_p1;
    reg        subtitle_box_p1;
    reg        subtitle_text_p1;
    wire [9:0] line_addr = (x < H_ACTIVE) ? x[9:0] : 10'd0;
    wire [7:0] edge_h_now = (x == 0) ? 8'd0 : abs_diff8(luma_now, left_luma);
    wire [7:0] edge_v_now = (y == 0) ? 8'd0 : abs_diff8(luma_now, line_luma[line_addr]);

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            left_luma     <= 8'd0;
            edge_sum_p1   <= 9'd0;
            luma_p1       <= 8'd0;
            rgb_p1        <= 24'd0;
            hs_p1         <= 1'b0;
            vs_p1         <= 1'b0;
            de_p1         <= 1'b0;
            mode_bar_p1   <= 1'b0;
            meter_bg_p1   <= 1'b0;
            meter_fill_p1 <= 1'b0;
            osd_box_p1    <= 1'b0;
            osd_text_p1   <= 1'b0;
            osd_marker_p1 <= 1'b0;
            subtitle_box_p1 <= 1'b0;
            subtitle_text_p1 <= 1'b0;
        end else begin
            hs_p1   <= hs;
            vs_p1   <= vs;
            de_p1   <= de;
            rgb_p1  <= de ? rgb_in : 24'd0;
            luma_p1 <= luma_now;
            mode_bar_p1 <= de && (y < 11'd10) && (x < 11'd72);
            meter_bg_p1 <= de && (y < 11'd10) &&
                           (x >= 11'd80) && (x < 11'd336);
            meter_fill_p1 <= de && (y < 11'd10) &&
                             (x >= 11'd80) &&
                             (x < ({3'd0, scene_luma} + 11'd80));
            osd_box_p1 <= osd_box;
            osd_text_p1 <= osd_text;
            subtitle_box_p1 <= subtitle_box;
            subtitle_text_p1 <= subtitle_text;
            osd_marker_p1 <= de && (x >= 11'd256) && (x < 11'd272) &&
                                      (y >= 11'd24) && (y < 11'd40);
            if (de) begin
                line_luma[line_addr] <= luma_now;
                left_luma    <= luma_now;
                edge_sum_p1  <= {1'b0, edge_h_now} + {1'b0, edge_v_now};
            end else begin
                left_luma   <= 8'd0;
                edge_sum_p1 <= 9'd0;
            end
        end
    end

    // Adaptive contrast, saturation and exposure arithmetic.
    wire signed [10:0] r_s = $signed({1'b0, rgb_p1[23:16]});
    wire signed [10:0] g_s = $signed({1'b0, rgb_p1[15:8]});
    wire signed [10:0] b_s = $signed({1'b0, rgb_p1[7:0]});
    wire signed [10:0] y_s = $signed({1'b0, luma_p1});
    wire signed [10:0] contrast_term = (y_s - 11'sd128) >>> 2;
    reg signed [10:0] exposure_bias;

    always @(*) begin
        if (scene_luma < 8'd96)
            exposure_bias = $signed({3'd0, (8'd96 - scene_luma)}) >>> 1;
        else if (scene_luma > 8'd184)
            exposure_bias = -($signed({3'd0, (scene_luma - 8'd184)}) >>> 2);
        else
            exposure_bias = 11'sd0;
    end

    wire signed [10:0] enhanced_r_s = r_s + ((r_s - y_s) >>> 2) +
                                       contrast_term + exposure_bias;
    wire signed [10:0] enhanced_g_s = g_s + ((g_s - y_s) >>> 2) +
                                       contrast_term + exposure_bias;
    wire signed [10:0] enhanced_b_s = b_s + ((b_s - y_s) >>> 2) +
                                       contrast_term + exposure_bias;
    wire [23:0] enhanced_rgb = {clamp_s11(enhanced_r_s),
                                clamp_s11(enhanced_g_s),
                                clamp_s11(enhanced_b_s)};
    wire [7:0] poster_r = poster_level(rgb_p1[23:16]);
    wire [7:0] poster_g = poster_level(rgb_p1[15:8]);
    wire [7:0] poster_b = poster_level(rgb_p1[7:0]);
    wire [8:0] poster_r_warm = {1'b0, poster_r} + 9'd16;
    wire [7:0] poster_r_out = poster_r_warm[8] ? 8'hff : poster_r_warm[7:0];
    wire [7:0] poster_b_out = (poster_b < 8'd12) ? 8'd0 : (poster_b - 8'd12);
    wire [23:0] poster_rgb = {poster_r_out, poster_g, poster_b_out};

    reg [23:0] processed_p2;
    reg        hs_p2;
    reg        vs_p2;
    reg        de_p2;
    reg [23:0] mode_color;

    always @(*) begin
        case (effect_mode)
            2'd0: mode_color = 24'hf4f4f4;
            2'd1: mode_color = 24'h36d66b;
            2'd2: mode_color = 24'h21d4fd;
            default: mode_color = 24'hff9f43;
        endcase
    end

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            processed_p2 <= 24'd0;
            hs_p2         <= 1'b0;
            vs_p2         <= 1'b0;
            de_p2         <= 1'b0;
        end else begin
            hs_p2 <= hs_p1;
            vs_p2 <= vs_p1;
            de_p2 <= de_p1;
            if (!de_p1)
                processed_p2 <= 24'd0;
            else if (mode_bar_p1)
                processed_p2 <= mode_color;
            else if (meter_fill_p1)
                processed_p2 <= (scene_luma < 8'd96) ? 24'hffd43b :
                                (scene_luma > 8'd184) ? 24'hff6b6b : 24'h51cf66;
            else if (meter_bg_p1)
                processed_p2 <= 24'h202830;
            else if (osd_text_p1)
                processed_p2 <= 24'hffffff;
            else if (subtitle_text_p1)
                processed_p2 <= 24'hffe66d;
            else if (osd_marker_p1)
                processed_p2 <= mode_color;
            else if (subtitle_box_p1) begin
                case (effect_mode)
                    2'd0: processed_p2 <= {2'b00, rgb_p1[23:18],
                                           2'b00, rgb_p1[15:10],
                                           2'b00, rgb_p1[7:2]};
                    2'd1: processed_p2 <= {2'b00, enhanced_rgb[23:18],
                                           2'b00, enhanced_rgb[15:10],
                                           2'b00, enhanced_rgb[7:2]};
                    2'd2: processed_p2 <= 24'h101820;
                    default: processed_p2 <= {2'b00, poster_rgb[23:18],
                                              2'b00, poster_rgb[15:10],
                                              2'b00, poster_rgb[7:2]};
                endcase
            end
            else if (osd_box_p1) begin
                case (effect_mode)
                    2'd0: processed_p2 <= {2'b00, rgb_p1[23:18],
                                           2'b00, rgb_p1[15:10],
                                           2'b00, rgb_p1[7:2]};
                    2'd1: processed_p2 <= {2'b00, enhanced_rgb[23:18],
                                           2'b00, enhanced_rgb[15:10],
                                           2'b00, enhanced_rgb[7:2]};
                    2'd2: processed_p2 <= 24'h101820;
                    default: processed_p2 <= {2'b00, poster_rgb[23:18],
                                              2'b00, poster_rgb[15:10],
                                              2'b00, poster_rgb[7:2]};
                endcase
            end
            else begin
                case (effect_mode)
                    2'd0: processed_p2 <= rgb_p1;
                    2'd1: processed_p2 <= enhanced_rgb;
                    2'd2: begin
                        if (edge_sum_p1 > 9'd96)
                            processed_p2 <= 24'h35e7ff;
                        else if (edge_sum_p1 > 9'd44)
                            processed_p2 <= {luma_p1, luma_p1, 8'hff};
                        else
                            processed_p2 <= {3{(luma_p1 >> 1)}};
                    end
                    default: processed_p2 <= poster_rgb;
                endcase
            end
        end
    end

    // Frame-stepped fade prevents abrupt picture/effect changes.
    wire [15:0] fade_r = processed_p2[23:16] * fade;
    wire [15:0] fade_g = processed_p2[15:8]  * fade;
    wire [15:0] fade_b = processed_p2[7:0]   * fade;
    wire [23:0] faded_rgb = {fade_r[15:8], fade_g[15:8], fade_b[15:8]};

    always @(posedge video_clk or posedge rst) begin
        if (rst) begin
            hs_o  <= 1'b0;
            vs_o  <= 1'b0;
            de_o  <= 1'b0;
            rgb_o <= 24'd0;
        end else begin
            hs_o <= hs_p2;
            vs_o <= vs_p2;
            de_o <= de_p2;
            if (!de_p2)
                rgb_o <= 24'd0;
            else if (fading)
                rgb_o <= faded_rgb;
            else
                rgb_o <= processed_p2;
        end
    end

endmodule

